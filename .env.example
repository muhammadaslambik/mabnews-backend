# Salin file ini menjadi ".env" lalu isi dengan data Anda sendiri.


# =========================================================
# DATABASE (Neon)
# Dashboard Neon > Project Anda > Connection Details
# Pilih yang "Pooled connection" untuk dipakai di sini.
# =========================================================
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/neondb?sslmode=require


# =========================================================
# PENYIMPANAN GAMBAR (ImageKit.io)
# Dashboard ImageKit > Developer Options
# =========================================================
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/nama-akun-anda


# =========================================================
# SERVER
# =========================================================

# Hanya dipakai saat menjalankan backend di komputer sendiri
# (npm run dev). Vercel mengatur port-nya sendiri otomatis.
PORT=3000

# Untuk mengizinkan portal/CMS memanggil API ini dari domain
# tertentu. Pakai "*" dulu selama development, ganti dengan
# domain asli (misalnya https://muhammadaslambik.github.io)
# saat production.
CORS_ORIGIN=*
